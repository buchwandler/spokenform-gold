{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spokenform.gold/schemas/completed-review-row.schema.json",
  "title": "Spokenform Gold completed canonical review row",
  "type": "object",
  "required": [
    "review_schema_version",
    "sentence_oracle_id",
    "reviewer_slot",
    "reviewer_id",
    "language",
    "locale",
    "input",
    "materialization",
    "source_refs",
    "annotation",
    "review"
  ],
  "properties": {
    "review_schema_version": { "type": "string", "minLength": 1 },
    "sentence_oracle_id": { "type": "string", "minLength": 1 },
    "reviewer_slot": { "enum": ["A", "B"] },
    "reviewer_id": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 2 },
    "locale": { "type": "string", "minLength": 2 },
    "input": { "type": "string" },
    "materialization": { "type": "string", "minLength": 1 },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["benchmark", "source_id"],
        "properties": {
          "benchmark": { "type": "string", "minLength": 1 },
          "source_id": { "type": "string", "minLength": 1 }
        }
      }
    },
    "annotation": {
      "type": "object",
      "required": [
        "status",
        "expected_output",
        "units",
        "negative_for",
        "notes",
        "oracle"
      ],
      "properties": {
        "status": {
          "enum": [
            "gold",
            "multi_valid",
            "policy_choice",
            "ambiguous",
            "no_change"
          ]
        },
        "expected_output": { "type": ["string", "null"] },
        "units": {
          "type": "array",
          "items": { "$ref": "record.schema.json#/properties/units/items" }
        },
        "negative_for": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" },
        "oracle": { "$ref": "oracle.schema.json" }
      }
    },
    "review": {
      "type": "object",
      "required": ["status", "protocol_version"],
      "properties": {
        "status": { "enum": ["review_a_complete", "review_b_complete"] },
        "protocol_version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
