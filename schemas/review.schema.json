{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spokenform Gold v2 independent sentence review",
  "type": "object",
  "required": [
    "review_schema_version",
    "case_id",
    "reviewer_slot",
    "language",
    "locale",
    "input",
    "annotation",
    "review"
  ],
  "properties": {
    "review_schema_version": { "const": "2.0.0" },
    "case_id": { "type": "string", "minLength": 1 },
    "reviewer_slot": { "enum": ["A", "B"] },
    "reviewer_id": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 2 },
    "locale": { "type": "string", "minLength": 2 },
    "input": { "type": "string" },
    "annotation": { "type": ["object", "null"] },
    "review": { "type": "object" }
  }
}
