{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spokenform.gold/schemas/canonical-review-decision.schema.json",
  "title": "Spokenform Gold canonical re-review adjudication decision",
  "type": "object",
  "required": [
    "sentence_oracle_id",
    "record_id",
    "family_id",
    "reviewers",
    "adjudicator",
    "review_status",
    "status",
    "input",
    "language",
    "locale",
    "expected_output",
    "units",
    "negative_for",
    "notes",
    "oracle"
  ],
  "properties": {
    "sentence_oracle_id": {"type": "string", "minLength": 1},
    "record_id": {"type": "string", "minLength": 1},
    "family_id": {"type": "string", "minLength": 1},
    "reviewers": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "adjudicator": {"type": "string", "minLength": 1},
    "review_status": {"enum": ["adjudicated", "release_ready"]},
    "review_protocol_version": {"type": "string", "minLength": 1},
    "decision": {"type": "string", "minLength": 1},
    "status": {"enum": ["gold", "multi_valid", "policy_choice", "ambiguous", "no_change"]},
    "input": {"type": "string"},
    "language": {"type": "string", "minLength": 2},
    "locale": {"type": "string", "minLength": 2},
    "expected_output": {"type": ["string", "null"]},
    "units": {
      "type": "array",
      "items": {"$ref": "record.schema.json#/properties/units/items"}
    },
    "negative_for": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"},
    "oracle": {"$ref": "oracle.schema.json"},
    "disagreement": {"type": "object"},
    "source_error_codes": {"type": "array", "items": {"type": "string"}}
  }
}
