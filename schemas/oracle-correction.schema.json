{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spokenform Gold targeted oracle correction",
  "type": "object",
  "required": ["record_id", "actor", "reason", "new_record"],
  "properties": {
    "record_id": { "type": "string", "minLength": 1 },
    "actor": { "type": "string", "minLength": 1 },
    "basis": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "new_record": { "type": "object" },
    "old_oracle_hash": { "type": "string", "minLength": 1 },
    "new_oracle_hash": { "type": "string", "minLength": 1 },
    "reviewed_by": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "adjudicator": { "type": "string", "minLength": 1 },
    "review_revision": { "type": "integer", "minimum": 1 },
    "previous_review_evidence_hash": { "type": "string", "minLength": 1 },
    "new_review_evidence_hash": { "type": "string", "minLength": 1 },
    "source_error_codes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "human_report": { "type": "string" },
    "changed_fields": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
