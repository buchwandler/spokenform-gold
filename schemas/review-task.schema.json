{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spokenform.gold/schemas/review-task.schema.json",
  "title": "Spokenform Gold review task instance",
  "type": "object",
  "required": ["schema_version", "task_type", "review_id", "records"],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "task_type": {
      "enum": [
        "canonical_rereview",
        "candidate_review",
        "candidate_adjudication",
        "canonical_integration",
        "candidate_integration",
        "release_publication"
      ]
    },
    "review_id": {"type": "string", "minLength": 1},
    "records": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "review_a": {"type": "string", "minLength": 1},
    "review_b": {"type": "string", "minLength": 1},
    "comparison": {"type": "string", "minLength": 1},
    "decisions": {"type": "string", "minLength": 1},
    "adjudicator_id": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"task_type": {"const": "canonical_rereview"}}},
      "then": {"required": ["review_a", "review_b", "comparison", "decisions", "adjudicator_id"]}
    },
    {
      "if": {"properties": {"task_type": {"const": "canonical_integration"}}},
      "then": {"required": ["review_a", "review_b", "decisions"]}
    }
  ]
}
