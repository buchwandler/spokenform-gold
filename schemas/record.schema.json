{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spokenform Gold record",
  "type": "object",
  "required": [
    "id",
    "language",
    "locale",
    "split",
    "family_id",
    "status",
    "input",
    "expected_output",
    "source",
    "units",
    "negative_for"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "locale": {
      "type": "string",
      "minLength": 2
    },
    "split": {
      "enum": [
        "train",
        "dev",
        "test",
        "challenge",
        "judge_gold",
        "candidate"
      ]
    },
    "family_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "gold",
        "multi_valid",
        "policy_choice",
        "ambiguous",
        "quarantine",
        "no_change"
      ]
    },
    "input": {
      "type": "string"
    },
    "expected_output": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "object"
    },
    "units": {
      "type": "array"
    },
    "negative_for": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
