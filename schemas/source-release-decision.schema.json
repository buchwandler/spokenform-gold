{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spokenform Gold source release decision",
  "type": "object",
  "required": ["schema_version", "source", "source_revision", "manifest_hash", "decision", "allowed_materializations", "license_evidence", "decision_hash"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "source": {"type": "string", "minLength": 1},
    "source_revision": {"type": "string", "minLength": 1},
    "manifest_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "decision": {"enum": ["embedded_public", "external_ref_only", "exclude_public", "needs_human_legal_review"]},
    "allowed_materializations": {"type": "array", "items": {"enum": ["embedded", "external_ref"]}, "uniqueItems": true},
    "license_evidence": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["kind", "locator", "sha256"], "properties": {"kind": {"type": "string"}, "locator": {"type": "string"}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}
    },
    "attribution_requirements": {"type": "array", "items": {"type": "string"}},
    "review_a": {"$ref": "#/$defs/review"},
    "review_b": {"$ref": "#/$defs/review"},
    "adjudication": {"type": "object"},
    "maintainer_approval": {"type": "object", "required": ["approved", "actor"], "properties": {"approved": {"type": "boolean"}, "actor": {"type": "string", "minLength": 1}, "decision_hash": {"type": "string"}}},
    "decision_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "review": {"type": "object", "required": ["reviewer_id", "result"], "properties": {"reviewer_id": {"type": "string", "minLength": 1}, "result": {"type": "string", "minLength": 1}, "notes": {"type": "string"}}}
  }
}
